# Postgres connection string. On Railway, reference the Postgres plugin's
# variable instead of hardcoding one: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://storm:storm@localhost:5432/storm_money

# The deployed storm-economy contract to index.
CONTRACT_ID=CBO4POPU3FQXXYE353LKO6KNHT2QJRZGOFDTQEKELS3H2ZZBNEPF3SOE

# Stellar RPC endpoint. Testnet by default; swap for a mainnet/pubnet RPC
# URL plus the matching contract ID if storm-economy ever deploys there.
RPC_URL=https://soroban-testnet.stellar.org

# How often the indexer polls getEvents, in milliseconds.
POLL_INTERVAL_MS=10000

# Max events requested per getEvents page (RPC providers commonly cap this
# around 1000-10000; 200 is comfortably inside every provider's limit for a
# low-volume contract).
POLL_PAGE_LIMIT=200

# HTTP port for the leaderboard API.
PORT=8080
